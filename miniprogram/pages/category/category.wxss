.page-category {
  display: flex;
  height: 100vh;
}

.category-sidebar {
  width: 180rpx;
  background: #f5f5f5;
  height: 100%;
  overflow-y: auto;
}

.sidebar-item {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-left: 6rpx solid transparent;
}

.sidebar-item.active {
  background: #fff;
  color: #ff6b35;
  font-weight: bold;
  border-left-color: #ff6b35;
}

.category-content {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  height: 100%;
  box-sizing: border-box;
}

.shop-card {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.shop-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.shop-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.shop-name {
  font-size: 28rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-rating {
  display: flex;
  align-items: center;
}

.shop-tags {
  display: flex;
  flex-wrap: wrap;
}
