.user-header {
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  padding: 60rpx 40rpx 40rpx;
  border-radius: 0 0 30rpx 30rpx;
}
.user-info-wrap { display: flex; align-items: center; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); }
.user-detail { margin-left: 30rpx; }
.user-name { font-size: 36rpx; font-weight: bold; color: #fff; display: block; }
.user-phone { color: rgba(255,255,255,0.8); display: block; margin-top: 8rpx; }
.login-wrap { display: flex; align-items: center; }
.default-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.3); display: flex; justify-content: center; align-items: center; font-size: 60rpx; }
.login-text { font-size: 36rpx; color: #fff; margin-left: 30rpx; font-weight: bold; }
.menu-list { background: #fff; margin: 30rpx 24rpx; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 30rpx; border-bottom: 1rpx solid #f5f5f5; }
.menu-item:last-child { border-bottom: none; }
.menu-left { display: flex; align-items: center; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-title { font-size: 30rpx; color: #333; }
.menu-arrow { font-size: 28rpx; color: #ccc; }
.logout-btn { margin: 40rpx 24rpx; padding: 24rpx; text-align: center; background: #fff; border-radius: 16rpx; color: #ff4d4f; font-size: 30rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
