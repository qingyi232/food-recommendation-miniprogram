<view class="container">
  <view class="card">
    <view class="form-item"><text class="form-label">商家名称</text><input class="form-input" value="{{form.name}}" bindinput="onInput" data-field="name"/></view>
    <view class="form-item"><text class="form-label">联系人</text><input class="form-input" value="{{form.contactName}}" bindinput="onInput" data-field="contactName"/></view>
    <view class="form-item"><text class="form-label">手机号</text><input class="form-input" type="number" value="{{form.phone}}" bindinput="onInput" data-field="phone"/></view>
    <view class="form-item"><text class="form-label">邮箱</text><input class="form-input" value="{{form.email}}" bindinput="onInput" data-field="email"/></view>
  </view>
  <button class="btn-primary" bindtap="saveInfo">保存</button>
</view>
