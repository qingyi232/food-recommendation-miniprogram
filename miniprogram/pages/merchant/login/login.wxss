.page-login { padding: 80rpx 50rpx; display: flex; flex-direction: column; align-items: center; }
.login-logo { font-size: 120rpx; margin-bottom: 20rpx; }
.login-title { font-size: 44rpx; font-weight: bold; color: #ff6b35; }
.login-subtitle { font-size: 26rpx; color: #999; margin-top: 10rpx; margin-bottom: 60rpx; }
.form-wrap { width: 100%; }
.form-item { margin-bottom: 30rpx; }
.form-label { font-size: 28rpx; color: #333; margin-bottom: 10rpx; display: block; }
.form-input { border: 2rpx solid #eee; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; background: #f9f9f9; }
.login-submit { margin-top: 40rpx; width: 100%; }
.register-link { text-align: center; margin-top: 40rpx; font-size: 28rpx; color: #999; }
