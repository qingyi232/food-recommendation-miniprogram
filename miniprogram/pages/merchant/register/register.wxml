<view class="page-login">
  <view class="login-logo">🏪</view>
  <text class="login-title">商家注册</text>
  <view class="form-wrap">
    <view class="form-item"><text class="form-label">用户名 *</text><input class="form-input" placeholder="请输入用户名" bindinput="onInput" data-field="username"/></view>
    <view class="form-item"><text class="form-label">密码 *</text><input class="form-input" placeholder="请输入密码" password bindinput="onInput" data-field="password"/></view>
    <view class="form-item"><text class="form-label">确认密码 *</text><input class="form-input" placeholder="请再次输入密码" password bindinput="onInput" data-field="confirmPassword"/></view>
    <view class="form-item"><text class="form-label">商家名称 *</text><input class="form-input" placeholder="请输入商家名称" bindinput="onInput" data-field="name"/></view>
    <view class="form-item"><text class="form-label">联系人</text><input class="form-input" placeholder="请输入联系人" bindinput="onInput" data-field="contactName"/></view>
    <view class="form-item"><text class="form-label">手机号</text><input class="form-input" placeholder="请输入手机号" type="number" bindinput="onInput" data-field="phone"/></view>
    <button class="btn-primary login-submit" bindtap="doRegister">注册</button>
  </view>
</view>
