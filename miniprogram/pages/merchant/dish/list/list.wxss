.shop-tabs { white-space: nowrap; padding: 16rpx 0; margin-bottom: 20rpx; }
.shop-tab { display: inline-block; padding: 12rpx 28rpx; margin-right: 16rpx; font-size: 26rpx; color: #666; border-radius: 28rpx; background: #f5f5f5; }
.shop-tab.active { background: #ff6b35; color: #fff; }
.dish-img { width: 140rpx; height: 100rpx; border-radius: 8rpx; margin-right: 16rpx; flex-shrink: 0; }
.dish-info { flex: 1; }
