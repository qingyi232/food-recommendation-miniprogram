.review-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; }
.review-content { font-size: 28rpx; color: #333; line-height: 1.6; display: block; }
.review-reply { background: #f5f5f5; padding: 16rpx; border-radius: 8rpx; }
.reply-input { width: 100%; height: 150rpx; border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx; font-size: 28rpx; background: #f9f9f9; box-sizing: border-box; }
.reply-actions { display: flex; }
.action-btn { padding: 8rpx 24rpx; background: #ff6b35; color: #fff; border-radius: 20rpx; font-size: 24rpx; margin-right: 16rpx; }
.action-btn.cancel { background: #999; }
