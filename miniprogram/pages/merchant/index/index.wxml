<view class="page-merchant">
  <view class="merchant-header">
    <image class="merchant-avatar" src="{{merchantInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"/>
    <view class="merchant-detail">
      <text class="merchant-name">{{merchantInfo.name}}</text>
      <text class="merchant-status">状态：{{merchantInfo.status === 1 ? '正常' : merchantInfo.status === 0 ? '待审核' : '已禁用'}}</text>
    </view>
  </view>

  <view class="stats-row" wx:if="{{stats}}">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalOrders || 0}}</text>
      <text class="stat-label">总订单</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.pendingOrders || 0}}</text>
      <text class="stat-label">待处理</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.completedOrders || 0}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-item">
      <text class="stat-value text-primary">¥{{stats.totalAmount || 0}}</text>
      <text class="stat-label">总收入</text>
    </view>
  </view>

  <view class="menu-grid">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="title" bindtap="goMenu" data-url="{{item.url}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-title">{{item.title}}</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">退出登录</view>
</view>
