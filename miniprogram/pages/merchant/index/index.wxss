.merchant-header { background: linear-gradient(135deg, #ff6b35, #ff8c5a); padding: 60rpx 40rpx 40rpx; display: flex; align-items: center; border-radius: 0 0 30rpx 30rpx; }
.merchant-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); }
.merchant-detail { margin-left: 24rpx; }
.merchant-name { font-size: 36rpx; font-weight: bold; color: #fff; display: block; }
.merchant-status { font-size: 24rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 8rpx; }
.stats-row { display: flex; background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 24rpx 0; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.stat-item { flex: 1; text-align: center; }
.stat-value { font-size: 36rpx; font-weight: bold; display: block; }
.stat-label { font-size: 22rpx; color: #999; display: block; margin-top: 8rpx; }
.menu-grid { display: flex; flex-wrap: wrap; margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; padding: 20rpx 0; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.menu-item { width: 33.33%; display: flex; flex-direction: column; align-items: center; padding: 24rpx 0; }
.menu-icon { font-size: 48rpx; }
.menu-title { font-size: 26rpx; color: #333; margin-top: 12rpx; }
.logout-btn { margin: 40rpx 24rpx; padding: 24rpx; text-align: center; background: #fff; border-radius: 16rpx; color: #ff4d4f; font-size: 30rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
