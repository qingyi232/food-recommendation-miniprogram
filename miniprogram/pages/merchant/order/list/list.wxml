<view class="page-order">
  <scroll-view class="status-bar" scroll-x>
    <view class="status-item {{currentStatus === item.value ? 'active' : ''}}" wx:for="{{statusList}}" wx:key="label" bindtap="switchStatus" data-status="{{item.value}}">{{item.label}}</view>
  </scroll-view>
  <view class="order-list">
    <view class="order-card card" wx:for="{{orders}}" wx:key="id">
      <view class="flex-between">
        <text class="text-sm">订单号：{{item.orderNo}}</text>
        <text class="text-sm text-primary">{{item.statusText}}</text>
      </view>
      <view class="flex-between mt-10">
        <text class="text-sm text-gray">用户：{{item.userName || '匿名'}}</text>
        <text class="text-sm text-gray">{{item.createTime}}</text>
      </view>
      <view class="divider"></view>
      <view class="order-item-row" wx:for="{{item.items}}" wx:for-item="dish" wx:key="id">
        <text class="flex-1 text-sm">{{dish.dishName}}</text>
        <text class="text-sm text-gray">x{{dish.quantity}}</text>
        <text class="text-sm ml-20">¥{{dish.amount}}</text>
      </view>
      <view class="divider"></view>
      <view class="flex-between">
        <text class="text-bold">合计：<text class="price">¥{{item.totalAmount}}</text></text>
        <view class="order-actions">
          <view class="action-btn" wx:if="{{item.status === 0}}" bindtap="confirmOrder" data-id="{{item.id}}">确认</view>
          <view class="action-btn" wx:if="{{item.status === 1}}" bindtap="completeOrder" data-id="{{item.id}}">完成</view>
          <view class="action-btn cancel" wx:if="{{item.status === 0}}" bindtap="cancelOrder" data-id="{{item.id}}">取消</view>
        </view>
      </view>
    </view>
  </view>
  <view class="empty-tip" wx:if="{{orders.length === 0 && !loading}}">暂无订单</view>
  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
</view>
