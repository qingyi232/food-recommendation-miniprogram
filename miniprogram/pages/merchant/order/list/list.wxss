.status-bar { white-space: nowrap; background: #fff; padding: 16rpx 24rpx; }
.status-item { display: inline-block; padding: 12rpx 28rpx; margin-right: 16rpx; font-size: 26rpx; color: #666; border-radius: 28rpx; background: #f5f5f5; }
.status-item.active { background: #ff6b35; color: #fff; }
.order-list { padding: 20rpx 24rpx; }
.order-item-row { display: flex; align-items: center; padding: 8rpx 0; }
.order-actions { display: flex; }
.action-btn { padding: 8rpx 24rpx; background: #ff6b35; color: #fff; border-radius: 20rpx; font-size: 24rpx; margin-left: 16rpx; }
.action-btn.cancel { background: #999; }
