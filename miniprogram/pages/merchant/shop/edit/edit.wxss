.form-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; }
.form-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); }
.form-content { position: absolute; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 30rpx 30rpx 0 0; padding: 40rpx; max-height: 80vh; overflow-y: auto; }
.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 26rpx; color: #333; margin-bottom: 8rpx; display: block; }
.form-input { border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; background: #f9f9f9; }
.form-textarea { border: 2rpx solid #eee; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; background: #f9f9f9; width: 100%; height: 150rpx; box-sizing: border-box; }
