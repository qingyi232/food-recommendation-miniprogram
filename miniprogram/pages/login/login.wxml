<view class="page-login">
  <view class="login-logo">🍽️</view>
  <text class="login-title">校园美食推荐</text>
  <text class="login-subtitle">发现身边美味</text>

  <view class="form-wrap">
    <view class="form-item">
      <text class="form-label">用户名</text>
      <input class="form-input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput"/>
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input class="form-input" placeholder="请输入密码" password value="{{password}}" bindinput="onPasswordInput"/>
    </view>
    <button class="btn-primary login-submit" bindtap="doLogin">登录</button>
    <button class="btn-wx" bindtap="wxLogin">微信快捷登录</button>
    <view class="register-link" bindtap="goRegister">
      <text>还没有账号？</text>
      <text class="text-primary">立即注册</text>
    </view>
  </view>
</view>
