.container {
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  text-align: center;
  padding: 28rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.stat-card.full-width {
  grid-column: 1 / -1;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
}

.stat-card.full-width .stat-value {
  color: #fff;
}

.stat-card.full-width .stat-label {
  color: rgba(255,255,255,0.85);
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  color: #333;
}

.stat-value.lg {
  font-size: 48rpx;
}

.stat-value.primary { color: #ff6b35; }
.stat-value.success { color: #52c41a; }
.stat-value.warn { color: #faad14; }

.stat-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.chart-header {
  margin-bottom: 16rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.chart-sub {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.chart-canvas {
  width: 100%;
}

.bar-canvas {
  height: 500rpx;
}

.pie-canvas {
  height: 450rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.shop-stat-item {
  border-bottom: 1rpx solid #f5f5f5;
  padding-bottom: 16rpx;
}

.shop-stat-item:last-child {
  border-bottom: none;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-20 { margin-top: 20rpx; }
.mt-10 { margin-top: 10rpx; }
.text-bold { font-weight: bold; }
.text-gray { color: #999; }
.text-sm { font-size: 24rpx; }
.rating-star { color: #ff6b35; font-size: 28rpx; }
.empty-tip { text-align: center; color: #999; padding: 40rpx 0; font-size: 26rpx; }
